<!DOCTYPE html>
<html lang="pt-br">

<head>

  <title>TheoMe</title>

  <!-- Required meta tags -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
    integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

  <!-- font -->
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <!-- icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css">

  <!-- bootstrap customization -->
  <link rel="stylesheet" href="/styles/pages/index.css" />
  <link rel="stylesheet" href="/styles/parts/main.css" />
  <link rel="stylesheet" href="/styles/parts/header.css" />
  <link rel="stylesheet" href="/styles/parts/footer.css" />
  <link rel="stylesheet" href="/styles/parts/navbar.css" />
  <link rel="stylesheet" href="/styles/parts/button.css" />
  <link rel="stylesheet" href="/styles/parts/grid.css" />


</head>

<body>

  <!-- jQuery first, then Popper.js, then Bootstrap JS -->
  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
    integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
    crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"
    integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
    crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
    integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
    crossorigin="anonymous"></script>

  <script src="/scripts/tools-HolyBible.js"></script>

  <%- include('../parts/header') %>

  <%- include('../parts/menu') %>

      <main>

        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item"><a href="#">Bíblia Sagrada</a></li>
            <li class="breadcrumb-item active" aria-current="page">Estilo literário</li>
          </ol>
        </nav>

        <div class="readingbar">

          <!-- BUTTONS -->

          <div class="barbutton">
            <a href="#">
              <div class="button-frame" data-toggle="tooltip" title="Menu anterior">
                <button class="btn btn-primary"><i class="fas fa-arrow-left"></i></button>
              </div>
            </a>
            <a href="#">
              <div class="button-frame" data-toggle="tooltip" title="Modo de leitura">
                <button class="btn btn-secondary"><i class="fas fa-expand"></i></button>
              </div>
            </a>
            <a href="#" data-toggle="modal" data-target="#Tools-BibleBookSelectionModal">
              <div class="button-frame" data-toggle="tooltip" title="Selecionar Livro e Capítulo">
                <button class="btn btn-secondary"><i class="fas fa-book"></i></button>
              </div>
            </a>
            <a href="#" data-toggle="modal" data-target="#Tools-BibleTranslationModal">
              <div class="button-frame" data-toggle="tooltip" title="Selecionar/Comparar Versões">
                <button class="btn btn-secondary" data-toggle="modal" data-target="#"><i
                    class="fas fa-copy"></i></button>
              </div>
            </a>
          </div>

          <!-- NAV TABS -->

          <div class="libraryiconbar">
            <ul class="nav nav-tabs" role="tablist">
              <li class="nav-item" role="presentation">
                <a href="#tabBookSummary" onclick="tabSelection('tabBookSummary')" class="nav-link active"
                  id="linkBookSummary" data-toggle="tab" role="tab" aria-controls="tabBookSummary" title="Resumo"><i
                    class="fas fa-search"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookData" onclick="tabSelection('tabBookData')" class="nav-link" id="linkBookData"
                  data-toggle="tab" role="tab" aria-controls="tabBookData" title="Dados"><i
                    class="fas fa-chart-bar"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookSchemaOfContent" onclick="tabSelection('tabBookSchemaOfContent')" class="nav-link"
                  id="linkBookSchemaOfContent" data-toggle="tab" role="tab" aria-controls="tabBookSchemaOfContent"
                  title="Esquema de Conteúdo"><i class="fas fa-list-ul"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookReadingPage" onclick="tabSelection('tabBookReadingPage')" class="nav-link"
                  id="linkBookReadingPage" data-toggle="tab" role="tab" aria-controls="tabBookReadingPage"
                  title="Texto Bíblico"><i class="fas fa-book-reader"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookPerson" onclick="tabSelection('tabBookPerson')" class="nav-link" id="linkBookPerson"
                  data-toggle="tab" role="tab" aria-controls="tabBookPerson" title="Personagens"><i
                    class="fas fa-user-friends"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookMap" onclick="tabSelection('tabBookMap')" class="nav-link" id="linkBookMap"
                  data-toggle="tab" role="tab" aria-controls="tabBookMap" title="Mapas"><i
                    class="fas fa-map-marked-alt"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookScene" onclick="tabSelection('tabBookScene')" class="nav-link" id="linkBookScene"
                  data-toggle="tab" role="tab" aria-controls="tabBookScene" title="Cenários"><i
                    class="fas fa-landmark"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookInfographic" onclick="tabSelection('tabBookInfographic')" class="nav-link"
                  id="linkBookInfographic" data-toggle="tab" role="tab" aria-controls="tabBookInfographic"
                  title="Infográficos"><i class="fas fa-swatchbook"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookLawCeremony" onclick="tabSelection('tabBookLawCeremony')" class="nav-link"
                  id="linkBookLawCeremony" data-toggle="tab" role="tab" aria-controls="tabBookLawCeremony"
                  title="Leis e Cerimônias"><i class="fas fa-balance-scale-right"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookUtensil" onclick="tabSelection('tabBookUtensil')" class="nav-link" id="linkBookUtensil"
                  data-toggle="tab" role="tab" aria-controls="tabBookUtensil" title="Utensílios, Armas e Ferramentas"><i
                    class="fas fa-hammer"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookMores" onclick="tabSelection('tabBookMores')" class="nav-link" id="linkBookMores"
                  data-toggle="tab" role="tab" aria-controls="tabBookMores" title="Costumes e Cultura"><i
                    class="fas fa-wine-glass-alt"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookSymbol" onclick="tabSelection('tabBookSymbol')" class="nav-link" id="linkBookSymbol"
                  data-toggle="tab" role="tab" aria-controls="tabBookSymbol" title="Símbolos"><i
                    class="fas fa-menorah"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookProphecy" onclick="tabSelection('tabBookProphecy')" class="nav-link"
                  id="linkBookProphecy" data-toggle="tab" role="tab" aria-controls="tabBookProphecy"
                  title="Profecias"><i class="fas fa-sun"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookHighlighter" onclick="tabSelection('tabBookHighlighter')" class="nav-link"
                  id="linkBookHighlighter" data-toggle="tab" role="tab" aria-controls="tabBookHighlighter"
                  title="Passagens mais conhecidas"><i class="fas fa-highlighter"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookPraise" onclick="tabSelection('tabBookPraise')" class="nav-link" id="linkBookPraise"
                  data-toggle="tab" role="tab" aria-controls="tabBookPraiser" title="Louvores"><i
                    class="fas fa-music"></i></a>
              </li>
              <li class="nav-item" role="presentation">
                <a href="#tabBookGlossary" onclick="tabSelection('tabBookGlossary')" class="nav-link"
                  id="linkBookGlossary" data-toggle="tab" role="tab" aria-controls="tabBookGlossary"
                  title="Glossário"><i class="fas fa-spell-check"></i></a>
              </li>
            </ul>
          </div>
        </div>

        <h1>Gênesis</h1>

        <div class="tab-content" id="tabContent">

          <div class="tab-pane fade show active" id="tabBookSummary" role="tabpanel"
            aria-labelledby="linkBookSummary">
            <%- include('../tools/P-BookSummary') %>
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookData" role="tabpanel"
            aria-labelledby="linkBookData">
            <%- include('../tools/P-BookData') %>
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookSchemaOfContent" role="tabpanel"
            aria-labelledby="linkBookSchemaOfContent">
            <%- include('../tools/P-BookSchemaOfContent') %>
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookReadingPage" role="tabpanel"
            aria-labelledby="linkBookReadingPage">
            <%- include('../tools/P-BookReadingPage') %>
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookPerson" role="tabpanel"
            aria-labelledby="linkBookPerson">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookMap" role="tabpanel" aria-labelledby="linkBookMap">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookScene" role="tabpanel"
            aria-labelledby="linkBookScene">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookInfographic" role="tabpanel"
            aria-labelledby="linkBookInfographic">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookLawCeremony" role="tabpanel"
            aria-labelledby="linkBookLawCeremony">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookUtensil" role="tabpanel"
            aria-labelledby="linkBookUtensil">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookMores" role="tabpanel"
            aria-labelledby="linkBookMores">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookSymbol" role="tabpanel"
            aria-labelledby="linkBookSymbol">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookProphecy" role="tabpanel"
            aria-labelledby="linkBookProphecy">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookHighlighter" role="tabpanel"
            aria-labelledby="linkBookHighlighter">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookPraise" role="tabpanel"
            aria-labelledby="linkBookPraise">
            Not found.
          </div>

          <div class="tab-pane fade" style="display:none" id="tabBookGlossary" role="tabpanel"
            aria-labelledby="linkBookGlossary">
            Not found.
          </div>

        </div>

      </main>

      <%- include('../parts/footer') %>

        <!-- MODAL TRIGGERS -->

        <!-- Bible Book Selection -->

        <div class="modal fade" id="Tools-BibleBookSelectionModal" tabindex="-1" aria-labelledby="exampleModalLabel"
          aria-hidden="true">
          <div class="modal-dialog">
            <%- include('Tools-BibleBookSelection-I') %>
          </div>
        </div>

        <!-- Bible Translation -->

        <div class="modal fade" id="Tools-BibleTranslationModal" tabindex="-1" aria-labelledby="exampleModalLabel"
          aria-hidden="true">
          <div class="modal-dialog">
            <%- include('Tools-BibleTranslationSelection-I') %>
          </div>
        </div>

        <!-- Item Description -->

        <div class="modal fade" id="Tools-ItemDescriptionModal" tabindex="-1" aria-labelledby="exampleModalLabel"
          aria-hidden="true">
          <div class="modal-dialog modal-lg">
            <%- include('Tools-ItemDescription-I') %>
          </div>
        </div>

</body>