<!DOCTYPE html>
<html lang="pt-br">

<head>

    <title>TheoMe</title>
    <link rel="icon" type="image/png" href="/images/logo_aba.png" />

    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

    <!-- font -->
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet" />
    <!-- icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css">

    <!-- bootstrap customization -->
    <link rel="stylesheet" href="/styles/parts/main.css" />
    <link rel="stylesheet" href="/styles/parts/header.css" />
    <link rel="stylesheet" href="/styles/parts/footer.css" />
    <link rel="stylesheet" href="/styles/parts/button.css" />
    <link rel="stylesheet" href="/styles/parts/grid.css" />

</head>

<body>

    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"
        integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
        crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
        integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
        crossorigin="anonymous"></script>

    <%- include('../parts/header') %>

        <%- include('../parts/navbar') %>

            <main>
                <h1>Consultar - País</h1>

                <!-- BREADCRUMB -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Cadastros</a></li>
                        <li class="breadcrumb-item active" aria-current="page">País</li>
                    </ol>
                </nav>

                <!-- POP-UP MESSAGE DISPLAY -->
                <div class="alert <%-messages.alertType%> <%-messages.display%> alertPosition" id="mensagemSucesso"
                    role="alert">
                    <input class="inputAlertMessage" id="message" name="message" value="<%= messages.textMessage%>"
                        disabled>
                    <a href="/cms-Country-Q/"><i class="fas fa-times closeAlertMessage"></i></a>
                </div>

                <!-- BAR BUTTON -->
                <div class="barbutton">
                    <a href="/cms-Country-C">
                        <div class="button-frame">
                            <button class="btn btn-success"><i class="fas fa-plus"></i></button>
                        </div>
                    </a>
                    <a href="#">
                        <div class="button-frame">
                            <button class="btn btn-secondary" data-toggle="modal"
                                data-target="#FilterCountryModal"><i class="fas fa-filter"></i></button>
                        </div>
                    </a>
                    <a href="#">
                        <div class="button-frame">
                            <button class="btn btn-secondary"><i class="fas fa-print"></i></button>
                        </div>
                    </a>
                </div>

                <!-- CONTENT -->
                <div class="routine-table">
                    <table class="table table-bordered table-striped table-sm table-hover">
                        <tr>
                            <th class="col-md-1">Cod.</th>
                            <th>País</th>
                            <th>Continente</th>                
                            <th class="col-md-1">Status</th>
                            <th class="col-md-1">Opções</th>   
                        </tr>
                        <% countries.forEach((country)=> { %>
                            <tr>
                                <td><%-country.id%></td>
                                <td><%-country.name%></td>
                                <td><%-country.continent%></td>
                                <td>
                                    <% if( country.status==='1' ) { %>
                                        <div class="statusActive">Ativo</div>
                                        <% } else { %>
                                            <div class="statusInative">Inativo</div>
                                            <% } %>
                                </td>
                                <td class="item-option">
                                    <a href="/cms-Country-C/<%= country.id %>"><i class="fas fa-pen"></i></a>
                                </td>
                            </tr>
                            <% }) %>
                    </table>
                </div>

                <!-- PAGINATION -->
                <div class="pagination-bar">
                    <span>
                        <% if (countSelect[0].totalRegister == 0 ) { %>
                                    Nenhum resultado encontrado.
                                <% } else { %>
                            Mostrando de <b>
                                <%= filterStatus.pageStartItem + 1 %>
                            </b> até
                            <% if ((filterStatus.pageStartItem + filterStatus.itemsPerPage) < countSelect[0].totalRegister) { %>
                                <b><%= filterStatus.pageStartItem + filterStatus.itemsPerPage %></b>
                                <% } else { %>
                                    <b><%= countSelect[0].totalRegister %></b>
                                <% } %>
                                    (de um total de <b><%=countSelect[0].totalRegister%></b> registros)
                        <% } %>
                    </span>
                    <div>
                        <form id="paginationPrevious" method="post" action="/cms-Country-Q/">
                            <input type="text" id="previousButton" name="previousButton" value="prevBtnClicked"
                                style="display:none">
                            <input type="text" id="currentPage" name="currentPage"
                                value="<%= filterStatus.currentPage%>" style="display:none">
                            <input type="text" id="itemsPerPage" name="itemsPerPage"
                                value="<%= filterStatus.itemsPerPage%>" style="display:none">
                            <input type="text" id="pageStartItem" name="pageStartItem"
                                value="<%= filterStatus.pageStartItem%>" style="display:none">
                            <input type="text" id="countryStatus" name="countryStatus"
                                value="<%= filterStatus.countryStatus%>" style="display:none">
                            <input type="text" id="countrySearch" name="countrySearch"
                                value="<%= filterStatus.countrySearch%>" style="display:none">
                        </form>
                        <form id="paginationNext" method="post" action="/cms-Country-Q/">
                            <input type="text" id="nextButton" name="nextButton" value="nextBtnClicked"
                                style="display:none">
                            <input type="text" id="currentPage" name="currentPage"
                                value="<%= filterStatus.currentPage%>" style="display:none">
                            <input type="text" id="itemsPerPage" name="itemsPerPage"
                                value="<%= filterStatus.itemsPerPage%>" style="display:none">
                            <input type="text" id="pageStartItem" name="pageStartItem"
                                value="<%= filterStatus.pageStartItem%>" style="display:none">
                            <input type="text" id="countryStatus" name="countryStatus"
                                value="<%= filterStatus.countryStatus%>" style="display:none">
                            <input type="text" id="countrySearch" name="countrySearch"
                                value="<%= filterStatus.countrySearch%>" style="display:none">
                        </form>
                    </div>
                    <div class="pagination-direction">
                        <button class="btn btn-secondary" form="paginationPrevious" type="submit"
                            title="Previous"><i class="fas fa-arrow-left"></i></button>
                        <div class="current-page">
                            <span> &nbsp Página <%= filterStatus.currentPage%> &nbsp </span>
                        </div>
                        <button class="btn btn-secondary" form="paginationNext" type="submit" title="Next"><i
                                class="fas fa-arrow-right"></i></button>
                    </div>
                </div>

                <!-- TRIGGER MODAL FILTER -->
                <div class="modal fade" id="FilterCountryModal" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog">
                        <%- include('cms-Country-F') %>
                    </div>
                </div>
                
            </main>

            <!-- CMS FOOTER -->
            <footer>
                <div class="card-body">
                    <span>Registros por página: <%= filterStatus.itemsPerPage%></span><br>
                    <span>Status:
                        <% if(filterStatus.countryStatus===1) { %>
                            Ativo
                            <% } else if (filterStatus.countryStatus===0){ %>
                                Inativo
                                <% } else { %>
                                    Todos
                                    <% } %>
                    </span><br>
                    <span>Pesquisa:
                        <% filterStatus.countrySearch %>
                            <% if(filterStatus.countrySearch==='%' ) { %>
                                Não informado
                                <% } else { %>
                                    <%=filterStatus.countrySearch %>
                                        <% } %>
                    </span><br>
                    <span>Ultima ação: <%= messages.textMessage%></span><br>
                </div>
            </footer>

            <%- include('../parts/copyright') %>

</body>