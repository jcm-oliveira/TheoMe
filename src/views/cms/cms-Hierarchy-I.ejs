                  <option value="" data-default disabled selected></option>
                  <option value="">Item de estudo XYZ</option>
                  <option value="">Item de estudo ABC</option>
                </select>
              </div>
            </div>

            <div class="row">
              <div class="col-md-4">
                <label for="" class="form-label">&#8592 Item Anterior</label>
                <select name="dataFormat" class="form-control">
                  <option value="" data-default disabled selected></option>
                  <option value="">Item de estudo XYZ</option>
                  <option value="">Item de estudo ABC</option>
                </select>
              </div>
              
              <div class="col-md-4">
                <label for="" form-label>Item referência</label>
                <input type="text" class="form-control" placeholder="Jacó" disabled>
              </div>

              <div class="col-md-4">
                <label for="" class="form-label">&#8594 Item Posterior</label>
                <select name="dataFormat" class="form-control">
                  <option value="" data-default disabled selected></option>
                  <option value="">Item de estudo XYZ</option>
                  <option value="">Item de estudo ABC</option>
                </select>
              </div>
            </div>

            <div class="input-center">
              <div class="col-md-4">
                <label for="" class="form-label">Item Inferior &#8595</label>
                <select name="dataFormat" class="form-control">
                  <option value="" data-default disabled selected></option>
                  <option value="">Item de estudo XYZ</option>
                  <option value="">Item de estudo ABC</option>
                </select>
              </div>
            </div>
          
