<!DOCTYPE html>
<html lang="pt-br">
<head>

  <title>TheoMe</title>

   <!-- Required meta tags -->
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

   <!-- Bootstrap CSS -->
   <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

   <!-- font -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"/>
   <!-- icons -->
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css">
    
    <!-- bootstrap customization -->
      <link rel="stylesheet" href="/styles/parts/main-cms.css" />
      <link rel="stylesheet" href="/styles/parts/header.css" />
      <link rel="stylesheet" href="/styles/parts/footer.css" />
      <link rel="stylesheet" href="/styles/parts/button.css" />
      <link rel="stylesheet" href="/styles/parts/grid.css" />

</head>

<body>
    
 <!-- jQuery first, then Popper.js, then Bootstrap JS -->
 <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
 <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
 <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>

    <%- include('../parts/header')  %>
  
    <%- include('../parts/navbar')  %>    
   
    <main>
        <h1>Consultar - Banner Slider</h1>

        <div class="barbutton">

            <a href="/cms-BannerSlider-C">
              <div class="button-frame">
                  <button class="btn btn-success"><i class="fas fa-plus"></i></button>
              </div>
            </a>
        
            <a href="#">
              <div class="button-frame">
                  <button class="btn btn-secondary" data-toggle="modal" data-target="#BannerSliderModal"><i class="fas fa-filter"></i></button>
              </div>
            </a>
        
            <a href="#">
              <div class="button-frame">
                  <button class="btn btn-secondary"><i class="fas fa-print"></i></button>
              </div>
            </a>
        
        </div>
        
        <div class="routine-table">
            <table class="table table-bordered table-striped table-sm table-hover">
                <tr>
                    <th>Cod.</th>
                    <th>Título</th>            
                    <th>Descrição</th>
                    <th>Botão</th>
                    <th>Status</th>
                    <th>Opções</th>           
                </tr>
                <tr>
                    <td>001</td>
                    <td>Seja Bem-vindo!</td>
                    <td>Textos bíblicos, Linha temporal, Mapas, Cenáculos, Infográficos, Personagens, Genealogias, Rituais, Cerimônias, Simbologias, Profecias, Poesias e Cânticos, Dicionário, Eventos Cronológicos e muitas outras informações disponíveis on-line.</td>
                    <td>-</td>
                    <td>Ativo</td>
                    <td class="item-option"><i class="fas fa-pen"></i></td>               
                </tr>
                <tr>
                    <td>002</td>
                    <td>Aprenda a orar com a Bíblia Sagrada.</td>
                    <td>Conheça as Orações realizadas em diversos momentos da história pelos personagens bíblicos em seus momentos de angústia, adoração e vitórias.</td>
                    <td>-</td>
                    <td>Ativo</td>
                    <td class="item-option"><i class="fas fa-pen"></i></td>  
                </tr>
                <tr>
                    <td>003</td>
                    <td>Conheça a verdadeira mensagem.</td>
                    <td>E, respondendo o Rei, lhes dirá: Em verdade vos digo que, quando o fizestes a um destes meus pequeninos irmãos a mim o fizestes.” (Mateus 25:40)</td>
                    <td>-</td>
                    <td>Ativo</td>
                    <td class="item-option"><i class="fas fa-pen"></i></td>  
                </tr>
                <tr>
                    <td>004</td>
                    <td>Seja um membro. Junte-se a nós.</td>
                    <td>Nossa missão é propagar o Cristianismo, buscando aproximar o Cristão ao seu propósito de Salvação através do conhecimento das Escrituras Sagradas da maneira mais simples, didática e acessível.</td>
                    <td>/mission</td>
                    <td>Ativo</td>
                    <td class="item-option"><i class="fas fa-pen"></i></td>  
                </tr>
            </table>
        </div>

            <!-- TRIGGER MODAL FILTER -->
            <div class="modal fade" id="BannerSliderModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog">

                    <%- include('cms-BannerSlider-F')  %>   

                </div>
              </div>
    <!-- END MODAL -->

    </main>

    <%- include('../parts/footer')  %> 
    
</body>