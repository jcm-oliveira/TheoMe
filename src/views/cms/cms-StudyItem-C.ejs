</head>

<body>

    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"
        integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1"
        crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"
        integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM"
        crossorigin="anonymous"></script>


    <%- include('../parts/header') %>

    <%- include('../parts/navbar') %>

    <main>
        <h1><%= formMode === "update" ? "Editar - Item de Estudo" : "Cadastrar - Item de Estudo" %></h1>

        <% if (typeof saveError !== "undefined" && saveError) { %>
            <div class="alert alert-danger" role="alert">
                O item de estudo não foi salvo por um erro no servidor (código: <b><%= saveError %></b>).
                As alterações feitas não foram gravadas.
            </div>
        <% } %>

        <form id="form-study-item" method="post" action="<%= formAction || '/cms-StudyItem-C' %>">
            <input type="hidden" id="attributeItemsJson" name="attributeItemsJson" value="<%= JSON.stringify(initialAttributeItems || []) %>">
            <input type="hidden" id="chronologyItemsJson" name="chronologyItemsJson" value="<%= JSON.stringify(initialChronologyItems || []) %>">
            <input type="hidden" id="hierarchyItemsJson" name="hierarchyItemsJson" value="<%= JSON.stringify(initialHierarchyItems || []) %>">
            <input type="hidden" id="associationItemsJson" name="associationItemsJson" value="<%= JSON.stringify(initialAssociationItems || []) %>">
            <input type="hidden" id="bibleMarkupItemsJson" name="bibleMarkupItemsJson" value="<%= JSON.stringify(initialBibleMarkupItems || []) %>">
            <fieldset class="flex">

<!-- Basic Data-->

                <legend><i class="fas fa-pen-nib">&nbsp&nbsp</i>Dados básicos</legend>
                <div class="row">
                    <div class="col-md-2">
                        <label for="" form-label>Código</label>
                        <input type="text" class="form-control" value="<%= studyItem ? studyItem.id : nextStudyItemCode %>" disabled>
                    </div>
                    <div class="col-md-2">
                        <label for="" form-label>Status</label>
                        <select name="studyItemStatus" class="form-control" required>
                            <option value="1" <%= studyItem && Number(studyItem.status) === 1 ? "selected" : "" %>>Ativo</option>
                            <option value="0" <%= studyItem && Number(studyItem.status) === 0 ? "selected" : "" %>>Inativo</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="" form-label>Idioma</label>
                        <select name="studyItemLanguage" class="form-control" required>
                            <option value="pt-BR" <%= studyItem && studyItem.language === "pt-BR" ? "selected" : "" %>>Português</option>
                            <option value="en-US" <%= studyItem && studyItem.language === "en-US" ? "selected" : "" %>>Inglês</option>
                        </select>
                    </div>
                        <div class="col-md-6">
                        <label for="" class="form-label">Perspectiva Histórica</label>
                        <select name="id_HistoricalPerspective" id="id_HistoricalPerspective" class="form-control" required>
                            <option value="" data-default disabled selected></option>
                            <% historicalPerspectives.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_historical_perspective) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
 
                <div class="row">
                    <div class="col-md-4">
                        <label for="" class="form-label">Categoria Nível 1</label>
                        <select name="id_CategoryLevel1" id="id_CategoryLevel1" class="form-control" required>
                            <option value="" data-default disabled selected></option>
                            <% categoryLevel1List.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_category_level_1) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="" class="form-label">Categoria Nível 2</label>
                        <select name="id_CategoryLevel2" id="id_CategoryLevel2" class="form-control" required>
                            <option value="" data-default disabled selected></option>
                            <% categoryLevel2List.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_category_level_2) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="" class="form-label">Categoria Nível 3</label>
                        <select name="id_CategoryLevel3" id="id_CategoryLevel3" class="form-control" required>
                            <option value="" data-default disabled selected></option>
                            <% categoryLevel3List.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_category_level_3) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                    <div class="col-md-14">
                        <label for="" class="form-label">Seção</label>
                        <select name="id_Section" id="id_Section" class="form-control" required>
                            <option value="" data-default disabled selected></option>
                            <% sectionList.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_section) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                        <div class="col-md-14">
                        <label for="" class="form-label">Nome do item de estudo</label>
                        <input type="text" name="studyItemName" class="form-control" value="<%= studyItem ? studyItem.name : '' %>" autofocus required>
                    </div>  

                <script>
                    const selHistoricalPerspective = document.getElementById("id_HistoricalPerspective");
                    const selLevel1 = document.getElementById("id_CategoryLevel1");
                    const selLevel2 = document.getElementById("id_CategoryLevel2");
                    const selLevel3 = document.getElementById("id_CategoryLevel3");
                    const selSection = document.getElementById("id_Section");

                    selHistoricalPerspective.addEventListener("change", function () {
                        const historicalPerspectiveId = this.value;
                        fetch("/cms-StudyItem-X-HistoricalPerspective", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ historicalPerspectiveId }),
                        })
                            .then((r) => r.json())
                            .then((level1Items) => {
                                selLevel1.innerHTML = '<option value="" data-default disabled selected></option>';
                                selLevel2.innerHTML = '<option value="" data-default disabled selected></option>';
                                selLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                                selSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                level1Items.forEach((item) => {
                                    const opt = document.createElement("option");
                                    opt.value = item.id;
                                    opt.textContent = item.name;
                                    selLevel1.appendChild(opt);
                                });
                            })
                            .catch((error) => console.error("Erro ao carregar categorias nível 1:", error));
                    });

                    selLevel1.addEventListener("change", function () {
                        const categoryLevel1Id = this.value;
                        fetch("/cms-StudyItem-X-Level1", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ categoryLevel1Id }),
                        })
                            .then((r) => r.json())
                            .then((level2Items) => {
                                selLevel2.innerHTML = '<option value="" data-default disabled selected></option>';
                                selLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                                selSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                level2Items.forEach((item) => {
                                    const opt = document.createElement("option");
                                    opt.value = item.id;
                                    opt.textContent = item.name;
                                    selLevel2.appendChild(opt);
                                });
                            })
                            .catch((error) => console.error("Erro ao carregar categorias nível 2:", error));
                    });

                    selLevel2.addEventListener("change", function () {
                        const categoryLevel2Id = this.value;
                        fetch("/cms-StudyItem-X-Level2", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ categoryLevel2Id }),
                        })
                            .then((r) => r.json())
                            .then((level3Items) => {
                                selLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                                selSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                level3Items.forEach((item) => {
                                    const opt = document.createElement("option");
                                    opt.value = item.id;
                                    opt.textContent = item.name;
                                    selLevel3.appendChild(opt);
                                });
                            })
                            .catch((error) => console.error("Erro ao carregar categorias nível 3:", error));
                    });

                    selLevel3.addEventListener("change", function () {
                        const categoryLevel3Id = this.value;
                        fetch("/cms-StudyItem-X-Level3", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ categoryLevel3Id }),
                        })
                            .then((r) => r.json())
                            .then((sectionItems) => {
                                selSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                sectionItems.forEach((item) => {
                                    const opt = document.createElement("option");
                                    opt.value = item.id;
                                    opt.textContent = item.name;
                                    selSection.appendChild(opt);
                                });
                            })
                            .catch((error) => console.error("Erro ao carregar seções:", error));
                    });
                </script>

<!-- Atributos -->

                <legend><i class="fas fa-book">&nbsp&nbsp</i>Atributos</legend>
                
                <div class="button-space">
                    <a href="#" data-toggle="modal" data-target="#AttributesModal">
                        <button class="btn btn-success" type="button"><i class="fas fa-plus"></i></button>
                    </a>
                </div>
                
                <div class="routine-table">
                    <table class="table table-bordered table-sm table-hover">
                        <tr>
                            <th>Cod.</th>
                            <th>Tipo de Atributo</th>
                            <th>Atributo</th>
                            <th>Descrição</th>
                            <th>Opções</th>
                        </tr>
                        <tbody id="studyItemAttributesTableBody"></tbody>
                    </table>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const modalAttributeType = document.getElementById("modalAttributeType");
                        const modalAttribute = document.getElementById("modalAttribute");
                        const modalAttributeDescription = document.getElementById("modalAttributeDescription");
                        const modalAttributeImageFile = document.getElementById("modalAttributeImageFile");
                        const modalAttributeImage = document.getElementById("modalAttributeImage");
                        const modalFigureLayout = document.getElementById("modalFigureLayout");
                        const modalAttributeVideo = document.getElementById("modalAttributeVideo");
                        const modalVideoLayout = document.getElementById("modalVideoLayout");
                        const btnInsertAttribute = document.getElementById("btnInsertAttribute");
                        const attributeItemsJsonInput = document.getElementById("attributeItemsJson");
                        const studyItemAttributesTableBody = document.getElementById("studyItemAttributesTableBody");

                        if (!modalAttributeType || !modalAttribute || !modalAttributeImageFile || !modalFigureLayout || !modalVideoLayout || !btnInsertAttribute) {
                            return;
                        }

                        let attributeItems = [];
                        try {
                            const parsedAttributeItems = JSON.parse(attributeItemsJsonInput.value || "[]");
                            attributeItems = Array.isArray(parsedAttributeItems) ? parsedAttributeItems : [];
                        } catch (error) {
                            attributeItems = [];
                        }
                        let editingAttributeIndex = null;
                        let uploadedAttributeImagePath = null;
                        let isUploadingAttributeImage = false;

                        function ensureSelectOption(selectElement, value, label) {
                            if (value === null || value === undefined || value === "") {
                                return;
                            }
                            const exists = Array.from(selectElement.options).some((opt) => String(opt.value) === String(value));
                            if (!exists) {
                                const opt = document.createElement("option");
                                opt.value = value;
                                opt.textContent = label || value;
                                selectElement.appendChild(opt);
                            }
                        }

                        function openAttributeModalForEdit(index) {
                            const item = attributeItems[index];
                            if (!item) {
                                return;
                            }

                            editingAttributeIndex = index;
                            uploadedAttributeImagePath = item.image || null;
                            modalAttributeDescription.value = item.description || "";
                            modalAttributeImage.value = item.image || "";
                            modalFigureLayout.value = item.figureLayout || "";
                            modalAttributeVideo.value = item.videoUrl || "";
                            modalVideoLayout.value = item.videoLayout || "";
                            modalAttributeImageFile.value = "";

                            modalAttributeType.value = item.idAttributeType || "";

                            if (modalAttributeType.value) {
                                fetch("/cms-StudyItem-X-AttributeType", {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ attributeTypeId: modalAttributeType.value }),
                                })
                                    .then((r) => r.json())
                                    .then((attributeItemsByType) => {
                                        modalAttribute.innerHTML = '<option value="" data-default disabled selected></option>';
                                        attributeItemsByType.forEach((attributeOption) => {
                                            const opt = document.createElement("option");
                                            opt.value = attributeOption.id;
                                            opt.textContent = attributeOption.name;
                                            modalAttribute.appendChild(opt);
                                        });

                                        ensureSelectOption(modalAttribute, item.idAttribute, item.attributeName);
                                        modalAttribute.value = item.idAttribute || "";
                                    })
                                    .catch(() => {
                                        modalAttribute.innerHTML = '<option value="" data-default disabled selected></option>';
                                        ensureSelectOption(modalAttribute, item.idAttribute, item.attributeName);
                                        modalAttribute.value = item.idAttribute || "";
                                    });
                            }

                            if (window.jQuery) {
                                window.jQuery("#AttributesModal").modal("show");
                            }
                        }

                        function updateAttributeItemsInput() {
                            attributeItemsJsonInput.value = JSON.stringify(attributeItems);
                        }

                        function renderAttributeItems() {
                            studyItemAttributesTableBody.innerHTML = "";

                            attributeItems.forEach((item, index) => {
                                const tr = document.createElement("tr");

                                const tdCode = document.createElement("td");
                                tdCode.textContent = String(index + 1).padStart(3, "0");
                                tr.appendChild(tdCode);

                                const tdType = document.createElement("td");
                                tdType.textContent = item.attributeTypeName;
                                tr.appendChild(tdType);

                                const tdAttribute = document.createElement("td");
                                tdAttribute.textContent = item.attributeName;
                                tr.appendChild(tdAttribute);

                                const tdDescription = document.createElement("td");
                                tdDescription.textContent = item.description || "";
                                tr.appendChild(tdDescription);

                                const tdOptions = document.createElement("td");
                                tdOptions.className = "item-option";

                                const editIcon = document.createElement("i");
                                editIcon.className = "fas fa-pen";
                                editIcon.style.cursor = "pointer";
                                editIcon.style.marginRight = "10px";
                                editIcon.addEventListener("click", function () {
                                    openAttributeModalForEdit(index);
                                });

                                const removeIcon = document.createElement("i");
                                removeIcon.className = "fas fa-trash-alt";
                                removeIcon.style.cursor = "pointer";
                                removeIcon.addEventListener("click", function () {
                                    attributeItems.splice(index, 1);
                                    updateAttributeItemsInput();
                                    renderAttributeItems();
                                });
                                tdOptions.appendChild(editIcon);
                                tdOptions.appendChild(removeIcon);
                                tr.appendChild(tdOptions);

                                studyItemAttributesTableBody.appendChild(tr);
                            });
                        }

                        modalAttributeType.addEventListener("change", function () {
                            const attributeTypeId = this.value;
                            fetch("/cms-StudyItem-X-AttributeType", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ attributeTypeId }),
                            })
                                .then((r) => r.json())
                                .then((attributeItemsByType) => {
                                    modalAttribute.innerHTML = '<option value="" data-default disabled selected></option>';
                                    attributeItemsByType.forEach((item) => {
                                        const opt = document.createElement("option");
                                        opt.value = item.id;
                                        opt.textContent = item.name;
                                        modalAttribute.appendChild(opt);
                                    });
                                })
                                .catch((error) => console.error("Erro ao carregar atributos:", error));
                        });

                        modalAttributeImageFile.addEventListener("change", function () {
                            const selectedFile = modalAttributeImageFile.files && modalAttributeImageFile.files[0];
                            if (!selectedFile) {
                                uploadedAttributeImagePath = null;
                                modalAttributeImage.value = "";
                                return;
                            }

                            const formData = new FormData();
                            formData.append("attributeImage", selectedFile);

                            isUploadingAttributeImage = true;
                            modalAttributeImage.value = "Enviando imagem...";

                            fetch("/cms-StudyItem-Upload-Attribute-Image", {
                                method: "POST",
                                body: formData,
                            })
                                .then((r) => r.json())
                                .then((uploadResult) => {
                                    uploadedAttributeImagePath = uploadResult.imagePath || null;
                                    modalAttributeImage.value = uploadedAttributeImagePath || "";
                                })
                                .catch(() => {
                                    uploadedAttributeImagePath = null;
                                    modalAttributeImage.value = "Erro no upload";
                                })
                                .finally(() => {
                                    isUploadingAttributeImage = false;
                                });
                        });

                        btnInsertAttribute.addEventListener("click", function () {
                            if (isUploadingAttributeImage) {
                                return;
                            }

                            if (!modalAttributeType.value || !modalAttribute.value) {
                                return;
                            }

                            const selectedTypeOption = modalAttributeType.options[modalAttributeType.selectedIndex];
                            const selectedAttributeOption = modalAttribute.options[modalAttribute.selectedIndex];

                            const upsertItem = {
                                idAttributeType: modalAttributeType.value,
                                attributeTypeName: selectedTypeOption ? selectedTypeOption.textContent : "",
                                idAttribute: modalAttribute.value,
                                attributeName: selectedAttributeOption ? selectedAttributeOption.textContent : "",
                                description: modalAttributeDescription.value || null,
                                image: uploadedAttributeImagePath || null,
                                figureLayout: modalFigureLayout.value || null,
                                videoUrl: modalAttributeVideo.value || null,
                                videoLayout: modalVideoLayout.value || null,
                            };

                            if (editingAttributeIndex !== null) {
                                attributeItems[editingAttributeIndex] = upsertItem;
                            } else {
                                attributeItems.push(upsertItem);
                            }

                            updateAttributeItemsInput();
                            renderAttributeItems();

                            modalAttributeType.value = "";
                            modalAttribute.innerHTML = '<option value="" data-default disabled selected></option>';
                            modalAttributeDescription.value = "";
                            modalAttributeImageFile.value = "";
                            modalAttributeImage.value = "";
                            modalFigureLayout.value = "";
                            modalAttributeVideo.value = "";
                            modalVideoLayout.value = "";
                            uploadedAttributeImagePath = null;
                            editingAttributeIndex = null;

                            if (window.jQuery) {
                                window.jQuery("#AttributesModal").modal("hide");
                            }
                        });

                        updateAttributeItemsInput();
                        renderAttributeItems();
                    });
                </script>


<!-- Geographic Localization -->

                <legend><i class="fas fa-globe">&nbsp&nbsp</i>Localização geográfica</legend>
                <div class="row">
                    <div class="col-md-3">
                        <label for="" class="form-label">Continente</label>
                        <select name="id_Continent" id="id_Continent" class="form-control">
                            <option value="" data-default disabled selected></option>
                            <% continents.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_continent) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">País</label>
                        <select name="id_Country" id="id_Country" class="form-control">
                            <option value="" data-default disabled selected></option>
                            <% countries.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_country) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="" class="form-label">Região</label>
                        <select name="id_Region" id="id_Region" class="form-control">
                            <option value="" data-default disabled selected></option>
                            <% regions.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_region) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <label for="" class="form-label">Estado</label>
                        <select name="id_State" id="id_State" class="form-control">
                            <option value="" data-default disabled selected></option>
                            <% states.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_state) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="" class="form-label">Cidade</label>
                        <select name="id_City" id="id_City" class="form-control">
                            <option value="" data-default disabled selected></option>
                            <% cities.forEach((item)=> { %>
                                <option value="<%-item.id%>" <%= studyItem && Number(studyItem.id_city) === Number(item.id) ? "selected" : "" %>><%-item.name%></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="" class="form-label">Bairro, Vila ou Distrito</label>
                        <input type="text" name="district" class="form-control" value="<%= studyItem && studyItem.district ? studyItem.district : '' %>">
                    </div>   
                </div>

                <script>
                    const selContinent = document.getElementById("id_Continent");
                    const selCountry = document.getElementById("id_Country");
                    const selRegion = document.getElementById("id_Region");
                    const selState = document.getElementById("id_State");
                    const selCity = document.getElementById("id_City");

                    selContinent.addEventListener("change", function () {
                        const continentId = this.value;
                        fetch("/cms-StudyItem-X-Continent", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ continentId }),
                        })
                            .then((r) => r.json())
                            .then((countryItems) => {
                                selCountry.innerHTML = '<option value="" data-default disabled selected></option>';
                                selRegion.innerHTML = '<option value="" data-default disabled selected></option>';
                                selState.innerHTML = '<option value="" data-default disabled selected></option>';
                                selCity.innerHTML = '<option value="" data-default disabled selected></option>';
                                countryItems.forEach((item) => {
                                    const opt = document.createElement("option");
                                    opt.value = item.id;
                                    opt.textContent = item.name;
                                    selCountry.appendChild(opt);
                                });
                            })
                            .catch((error) => console.error("Erro ao carregar países:", error));
                    });

                    selCountry.addEventListener("change", function () {
                        const countryId = this.value;
                        fetch("/cms-StudyItem-X-Country", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ countryId }),
                        })
                            .then((r) => r.json())
                            .then((regionItems) => {
                                selRegion.innerHTML = '<option value="" data-default disabled selected></option>';
                                selState.innerHTML = '<option value="" data-default disabled selected></option>';
                                selCity.innerHTML = '<option value="" data-default disabled selected></option>';
