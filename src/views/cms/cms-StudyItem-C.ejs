<!-- Item Association-->

                <legend><i class="fas fa-link">&nbsp&nbsp</i>Associação de itens</legend>

                <div class="button-space">
                    <a href="#" data-toggle="modal" data-target="#ItemAssociationModal">
                        <button class="btn btn-success" type="button"><i class="fas fa-plus"></i></button>
                    </a>
                </div>

                <div class="routine-table">
                    <table class="table table-bordered table-sm table-hover">
                        <tr>
                            <th>Cod.</th>
                            <th>Perspectiva Histórica</th>
                            <th>Categoria Nível 1</th>
                            <th>Categoria Nível 2</th>
                            <th>Categoria Nível 3</th>
                            <th>Seção</th>
                            <th>Tipo de Associação</th>
                            <th>item Associado</th>
                            <th>Opções</th>
                        </tr>
                        <tbody id="studyItemAssociationTableBody"></tbody>
                    </table>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const associationItemsJsonInput = document.getElementById("associationItemsJson");
                        const associationTableBody = document.getElementById("studyItemAssociationTableBody");
                        const associationHistoricalPerspective = document.getElementById("associationHistoricalPerspective");
                        const associationCategoryLevel1 = document.getElementById("associationCategoryLevel1");
                        const associationCategoryLevel2 = document.getElementById("associationCategoryLevel2");
                        const associationCategoryLevel3 = document.getElementById("associationCategoryLevel3");
                        const associationSection = document.getElementById("associationSection");
                        const associationType = document.getElementById("associationType");
                        const associationStudyItem = document.getElementById("associationStudyItem");
                        const btnInsertAssociation = document.getElementById("btnInsertAssociation");

                        if (!associationItemsJsonInput || !associationTableBody || !associationHistoricalPerspective || !associationCategoryLevel1 || !associationCategoryLevel2 || !associationCategoryLevel3 || !associationSection || !associationType || !associationStudyItem || !btnInsertAssociation) {
                            return;
                        }

                        let associationItems = [];
                        try {
                            const parsedAssociationItems = JSON.parse(associationItemsJsonInput.value || "[]");
                            associationItems = Array.isArray(parsedAssociationItems) ? parsedAssociationItems : [];
                        } catch (error) {
                            associationItems = [];
                        }
                        let editingAssociationIndex = null;

                        function ensureSelectOption(selectElement, value, label) {
                            if (value === null || value === undefined || value === "") {
                                return;
                            }
                            const exists = Array.from(selectElement.options).some((opt) => String(opt.value) === String(value));
                            if (!exists) {
                                const opt = document.createElement("option");
                                opt.value = value;
                                opt.textContent = label || value;
                                selectElement.appendChild(opt);
                            }
                        }

                        function openAssociationModalForEdit(index) {
                            const item = associationItems[index];
                            if (!item) {
                                return;
                            }

                            editingAssociationIndex = index;

                            ensureSelectOption(associationHistoricalPerspective, item.idHistoricalPerspective, item.historicalPerspectiveName);
                            ensureSelectOption(associationCategoryLevel1, item.idCategoryLevel1, item.categoryLevel1Name);
                            ensureSelectOption(associationCategoryLevel2, item.idCategoryLevel2, item.categoryLevel2Name);
                            ensureSelectOption(associationCategoryLevel3, item.idCategoryLevel3, item.categoryLevel3Name);
                            ensureSelectOption(associationSection, item.idSection, item.sectionName);
                            ensureSelectOption(associationStudyItem, item.idAssociatedStudyItem, item.associatedStudyItemName);

                            associationHistoricalPerspective.value = item.idHistoricalPerspective || "";
                            associationCategoryLevel1.value = item.idCategoryLevel1 || "";
                            associationCategoryLevel2.value = item.idCategoryLevel2 || "";
                            associationCategoryLevel3.value = item.idCategoryLevel3 || "";
                            associationSection.value = item.idSection || "";
                            associationType.value = item.associationType || "";
                            associationStudyItem.value = item.idAssociatedStudyItem || "";

                            if (window.jQuery) {
                                window.jQuery("#ItemAssociationModal").modal("show");
                            }
                        }

                        function updateAssociationItemsInput() {
                            associationItemsJsonInput.value = JSON.stringify(associationItems);
                        }

                        function renderAssociationItems() {
                            associationTableBody.innerHTML = "";
                            associationItems.forEach((item, index) => {
                                const tr = document.createElement("tr");

                                const tdCode = document.createElement("td");
                                tdCode.textContent = String(index + 1).padStart(3, "0");
                                tr.appendChild(tdCode);

                                const tdHistorical = document.createElement("td");
                                tdHistorical.textContent = item.historicalPerspectiveName;
                                tr.appendChild(tdHistorical);

                                const tdLevel1 = document.createElement("td");
                                tdLevel1.textContent = item.categoryLevel1Name;
                                tr.appendChild(tdLevel1);

                                const tdLevel2 = document.createElement("td");
                                tdLevel2.textContent = item.categoryLevel2Name;
                                tr.appendChild(tdLevel2);

                                const tdLevel3 = document.createElement("td");
                                tdLevel3.textContent = item.categoryLevel3Name;
                                tr.appendChild(tdLevel3);

                                const tdSection = document.createElement("td");
                                tdSection.textContent = item.sectionName;
                                tr.appendChild(tdSection);

                                const tdAssociationType = document.createElement("td");
                                tdAssociationType.textContent = item.associationType || "";
                                tr.appendChild(tdAssociationType);

                                const tdStudyItem = document.createElement("td");
                                tdStudyItem.textContent = item.associatedStudyItemName;
                                tr.appendChild(tdStudyItem);

                                const tdOptions = document.createElement("td");
                                tdOptions.className = "item-option";

                                const editIcon = document.createElement("i");
                                editIcon.className = "fas fa-pen";
                                editIcon.style.cursor = "pointer";
                                editIcon.style.marginRight = "10px";
                                editIcon.addEventListener("click", function () {
                                    openAssociationModalForEdit(index);
                                });

                                const removeIcon = document.createElement("i");
                                removeIcon.className = "fas fa-trash-alt";
                                removeIcon.style.cursor = "pointer";
                                removeIcon.addEventListener("click", function () {
                                    associationItems.splice(index, 1);
                                    updateAssociationItemsInput();
                                    renderAssociationItems();
                                });
                                tdOptions.appendChild(editIcon);
                                tdOptions.appendChild(removeIcon);
                                tr.appendChild(tdOptions);

                                associationTableBody.appendChild(tr);
                            });
                        }

                        associationHistoricalPerspective.addEventListener("change", function () {
                            const historicalPerspectiveId = this.value;
                            fetch("/cms-StudyItem-X-HistoricalPerspective", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ historicalPerspectiveId }),
                            })
                                .then((r) => r.json())
                                .then((level1Items) => {
                                    associationCategoryLevel1.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationCategoryLevel2.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationCategoryLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationStudyItem.innerHTML = '<option value="" data-default disabled selected></option>';
                                    level1Items.forEach((item) => {
                                        const opt = document.createElement("option");
                                        opt.value = item.id;
                                        opt.textContent = item.name;
                                        associationCategoryLevel1.appendChild(opt);
                                    });
                                });
                        });

                        associationCategoryLevel1.addEventListener("change", function () {
                            const categoryLevel1Id = this.value;
                            fetch("/cms-StudyItem-X-Level1", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ categoryLevel1Id }),
                            })
                                .then((r) => r.json())
                                .then((level2Items) => {
                                    associationCategoryLevel2.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationCategoryLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationStudyItem.innerHTML = '<option value="" data-default disabled selected></option>';
                                    level2Items.forEach((item) => {
                                        const opt = document.createElement("option");
                                        opt.value = item.id;
                                        opt.textContent = item.name;
                                        associationCategoryLevel2.appendChild(opt);
                                    });
                                });
                        });

                        associationCategoryLevel2.addEventListener("change", function () {
                            const categoryLevel2Id = this.value;
                            fetch("/cms-StudyItem-X-Level2", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ categoryLevel2Id }),
                            })
                                .then((r) => r.json())
                                .then((level3Items) => {
                                    associationCategoryLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationStudyItem.innerHTML = '<option value="" data-default disabled selected></option>';
                                    level3Items.forEach((item) => {
                                        const opt = document.createElement("option");
                                        opt.value = item.id;
                                        opt.textContent = item.name;
                                        associationCategoryLevel3.appendChild(opt);
                                    });
                                });
                        });

                        associationCategoryLevel3.addEventListener("change", function () {
                            const categoryLevel3Id = this.value;
                            fetch("/cms-StudyItem-X-Level3", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ categoryLevel3Id }),
                            })
                                .then((r) => r.json())
                                .then((sectionItems) => {
                                    associationSection.innerHTML = '<option value="" data-default disabled selected></option>';
                                    associationStudyItem.innerHTML = '<option value="" data-default disabled selected></option>';
                                    sectionItems.forEach((item) => {
                                        const opt = document.createElement("option");
                                        opt.value = item.id;
                                        opt.textContent = item.name;
                                        associationSection.appendChild(opt);
                                    });
                                });
                        });

                        associationSection.addEventListener("change", function () {
                            const sectionId = this.value;
                            fetch("/cms-StudyItem-X-Association-Section", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ sectionId }),
                            })
                                .then((r) => r.json())
                                .then((studyItems) => {
                                    associationStudyItem.innerHTML = '<option value="" data-default disabled selected></option>';
                                    studyItems.forEach((item) => {
                                        const opt = document.createElement("option");
                                        opt.value = item.id;
                                        opt.textContent = item.name;
                                        associationStudyItem.appendChild(opt);
                                    });
                                });
                        });

                        btnInsertAssociation.addEventListener("click", function () {
                            if (!associationHistoricalPerspective.value || !associationCategoryLevel1.value || !associationCategoryLevel2.value || !associationCategoryLevel3.value || !associationSection.value || !associationType.value.trim() || !associationStudyItem.value) {
                                return;
                            }

                            const upsertItem = {
                                idHistoricalPerspective: associationHistoricalPerspective.value,
                                historicalPerspectiveName: associationHistoricalPerspective.options[associationHistoricalPerspective.selectedIndex].textContent,
                                idCategoryLevel1: associationCategoryLevel1.value,
                                categoryLevel1Name: associationCategoryLevel1.options[associationCategoryLevel1.selectedIndex].textContent,
                                idCategoryLevel2: associationCategoryLevel2.value,
                                categoryLevel2Name: associationCategoryLevel2.options[associationCategoryLevel2.selectedIndex].textContent,
                                idCategoryLevel3: associationCategoryLevel3.value,
                                categoryLevel3Name: associationCategoryLevel3.options[associationCategoryLevel3.selectedIndex].textContent,
                                idSection: associationSection.value,
                                sectionName: associationSection.options[associationSection.selectedIndex].textContent,
                                associationType: associationType.value.trim(),
                                idAssociatedStudyItem: associationStudyItem.value,
                                associatedStudyItemName: associationStudyItem.options[associationStudyItem.selectedIndex].textContent,
                            };

                            if (editingAssociationIndex !== null) {
                                associationItems[editingAssociationIndex] = upsertItem;
                            } else {
                                associationItems.push(upsertItem);
                            }

                            updateAssociationItemsInput();
                            renderAssociationItems();

                            associationHistoricalPerspective.value = "";
                            associationCategoryLevel1.innerHTML = '<option value="" data-default disabled selected></option>';
                            associationCategoryLevel2.innerHTML = '<option value="" data-default disabled selected></option>';
                            associationCategoryLevel3.innerHTML = '<option value="" data-default disabled selected></option>';
                            associationSection.innerHTML = '<option value="" data-default disabled selected></option>';
                            associationType.value = "";
                            associationStudyItem.innerHTML = '<option value="" data-default disabled selected></option>';
                            editingAssociationIndex = null;

                            if (window.jQuery) {
                                window.jQuery("#ItemAssociationModal").modal("hide");
                            }
                        });

                        updateAssociationItemsInput();
                        renderAssociationItems();
                    });
                </script>

<!-- Bible Markup -->

                <legend><i class="fas fa-bookmark">&nbsp&nbsp</i>Marcação Bíblica</legend>

                <div class="button-space">
                    <a href="#" data-toggle="modal" data-target="#BibleMarkupModal">
                        <button class="btn btn-success" type="button"><i class="fas fa-plus"></i></button>
                    </a>
                </div>

                <div class="routine-table">
                    <table class="table table-bordered table-sm table-hover">
                        <tr>
                            <th>Cod.</th>
                            <th>Livro</th>
                            <th>Capítulo</th>
                            <th>Verso inicial</th>
                            <th>Verso final</th>
                            <th>Opções</th>
                        </tr>
                        <tbody id="studyItemBibleMarkupTableBody"></tbody>
                    </table>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const bibleMarkupItemsJsonInput = document.getElementById("bibleMarkupItemsJson");
                        const bibleMarkupTableBody = document.getElementById("studyItemBibleMarkupTableBody");
                        const bibleMarkupBook = document.getElementById("bibleMarkupBook");
                        const bibleMarkupChapter = document.getElementById("bibleMarkupChapter");
                        const bibleMarkupVerseStart = document.getElementById("bibleMarkupVerseStart");
                        const bibleMarkupVerseEnd = document.getElementById("bibleMarkupVerseEnd");
                        const btnInsertBibleMarkup = document.getElementById("btnInsertBibleMarkup");

                        if (!bibleMarkupItemsJsonInput || !bibleMarkupTableBody || !bibleMarkupBook || !bibleMarkupChapter || !bibleMarkupVerseStart || !bibleMarkupVerseEnd || !btnInsertBibleMarkup) {
                            return;
                        }

                        let bibleMarkupItems = [];
                        try {
                            const parsedBibleMarkupItems = JSON.parse(bibleMarkupItemsJsonInput.value || "[]");
                            bibleMarkupItems = Array.isArray(parsedBibleMarkupItems) ? parsedBibleMarkupItems : [];
                        } catch (error) {
                            bibleMarkupItems = [];
                        }
                        let editingBibleMarkupIndex = null;

                        function ensureSelectOption(selectElement, value, label) {
                            if (value === null || value === undefined || value === "") {
                                return;
                            }
                            const exists = Array.from(selectElement.options).some((opt) => String(opt.value) === String(value));
                            if (!exists) {
                                const opt = document.createElement("option");
                                opt.value = value;
                                opt.textContent = label || value;
                                selectElement.appendChild(opt);
                            }
                        }

                        function openBibleMarkupModalForEdit(index) {
                            const item = bibleMarkupItems[index];
                            if (!item) {
                                return;
                            }

                            editingBibleMarkupIndex = index;
                            ensureSelectOption(bibleMarkupBook, item.idBook, item.bookName);
                            bibleMarkupBook.value = item.idBook || "";
                            bibleMarkupChapter.value = item.chapter || "";
                            bibleMarkupVerseStart.value = item.verseStart || "";
                            bibleMarkupVerseEnd.value = item.verseEnd || "";

                            if (window.jQuery) {
                                window.jQuery("#BibleMarkupModal").modal("show");
                            }
                        }

                        function updateBibleMarkupItemsInput() {
                            bibleMarkupItemsJsonInput.value = JSON.stringify(bibleMarkupItems);
                        }

                        function renderBibleMarkupItems() {
                            bibleMarkupTableBody.innerHTML = "";
                            bibleMarkupItems.forEach((item, index) => {
                                const tr = document.createElement("tr");

                                const tdCode = document.createElement("td");
                                tdCode.textContent = String(index + 1).padStart(3, "0");
                                tr.appendChild(tdCode);

                                const tdBook = document.createElement("td");
                                tdBook.textContent = item.bookName;
                                tr.appendChild(tdBook);

                                const tdChapter = document.createElement("td");
                                tdChapter.textContent = item.chapter;
                                tr.appendChild(tdChapter);

                                const tdVerseStart = document.createElement("td");
                                tdVerseStart.textContent = item.verseStart;
                                tr.appendChild(tdVerseStart);

                                const tdVerseEnd = document.createElement("td");
                                tdVerseEnd.textContent = item.verseEnd;
                                tr.appendChild(tdVerseEnd);

                                const tdOptions = document.createElement("td");
                                tdOptions.className = "item-option";

                                const editIcon = document.createElement("i");
                                editIcon.className = "fas fa-pen";
                                editIcon.style.cursor = "pointer";
                                editIcon.style.marginRight = "10px";
                                editIcon.addEventListener("click", function () {
                                    openBibleMarkupModalForEdit(index);
                                });

                                const removeIcon = document.createElement("i");
                                removeIcon.className = "fas fa-trash-alt";
                                removeIcon.style.cursor = "pointer";
                                removeIcon.addEventListener("click", function () {
                                    bibleMarkupItems.splice(index, 1);
                                    updateBibleMarkupItemsInput();
                                    renderBibleMarkupItems();
                                });
                                tdOptions.appendChild(editIcon);
                                tdOptions.appendChild(removeIcon);
                                tr.appendChild(tdOptions);

                                bibleMarkupTableBody.appendChild(tr);
                            });
                        }

                        btnInsertBibleMarkup.addEventListener("click", function () {
                            if (!bibleMarkupBook.value || !bibleMarkupChapter.value || !bibleMarkupVerseStart.value || !bibleMarkupVerseEnd.value) {
                                return;
                            }

                            const upsertItem = {
                                idBook: bibleMarkupBook.value,
                                bookName: bibleMarkupBook.options[bibleMarkupBook.selectedIndex].textContent,
                                chapter: bibleMarkupChapter.value,
                                verseStart: bibleMarkupVerseStart.value,
                                verseEnd: bibleMarkupVerseEnd.value,
                            };

                            if (editingBibleMarkupIndex !== null) {
                                bibleMarkupItems[editingBibleMarkupIndex] = upsertItem;
                            } else {
                                bibleMarkupItems.push(upsertItem);
                            }

                            updateBibleMarkupItemsInput();
                            renderBibleMarkupItems();

                            bibleMarkupBook.value = "";
                            bibleMarkupChapter.value = "";
                            bibleMarkupVerseStart.value = "";
                            bibleMarkupVerseEnd.value = "";
                            editingBibleMarkupIndex = null;

                            if (window.jQuery) {
                                window.jQuery("#BibleMarkupModal").modal("hide");
                            }
                        });

                        updateBibleMarkupItemsInput();
                        renderBibleMarkupItems();
                    });
                </script>

    </fieldset>
</form>

