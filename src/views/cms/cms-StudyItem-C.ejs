<!-- Chronology - Timeline Register -->

                <legend><i class="fas fa-history">&nbsp&nbsp</i>Cronologia - Registro na linha do tempo</legend>

                <div class="button-space">
                    <a href="#" data-toggle="modal" data-target="#ChronologyModal">
                        <button class="btn btn-success" type="button"><i class="fas fa-plus"></i></button>
                    </a>
                </div>

                <div class="routine-table">
                    <table class="table table-bordered table-sm table-hover">
                        <tr>
                            <th>Cod.</th>
                            <th>Linha Temporal</th>
                            <th>Tipo Registro</th>
                            <th>Cor da Barra</th>
                            <th>Início</th>
                            <th>Término</th>
                            <th>Opções</th>
                        </tr>
                        <tbody id="studyItemChronologyTableBody"></tbody>
                    </table>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const chronologyItemsJsonInput = document.getElementById("chronologyItemsJson");
                        const chronologyTableBody = document.getElementById("studyItemChronologyTableBody");
                        const chronologyTimeline = document.getElementById("chronologyTimeline");
                        const chronologyRegisterType = document.getElementById("RegisterType");
                        const chronologyBarColor = document.getElementById("chronologyBarColor");
                        const chronologyStartDay = document.getElementById("chronologyStartDay");
                        const chronologyStartMonth = document.getElementById("chronologyStartMonth");
                        const chronologyStartYear = document.getElementById("chronologyStartYear");
                        const chronologyStartReference = document.getElementById("chronologyStartReference");
                        const chronologyEndDay = document.getElementById("chronologyEndDay");
                        const chronologyEndMonth = document.getElementById("chronologyEndMonth");
                        const chronologyEndYear = document.getElementById("chronologyEndYear");
                        const chronologyEndReference = document.getElementById("chronologyEndReference");
                        const btnInsertChronology = document.getElementById("btnInsertChronology");

                        if (!chronologyItemsJsonInput || !chronologyTableBody || !chronologyTimeline || !chronologyRegisterType || !btnInsertChronology) {
                            return;
                        }

                        let chronologyItems = [];
                        try {
                            const parsedChronologyItems = JSON.parse(chronologyItemsJsonInput.value || "[]");
                            chronologyItems = Array.isArray(parsedChronologyItems) ? parsedChronologyItems : [];
                        } catch (error) {
                            chronologyItems = [];
                        }
                        let editingChronologyIndex = null;

                        function openChronologyModalForEdit(index) {
                            const item = chronologyItems[index];
                            if (!item) {
                                return;
                            }

                            editingChronologyIndex = index;
                            chronologyTimeline.value = item.idTimeline || "";
                            chronologyRegisterType.value = item.registerType || "";
                            chronologyBarColor.value = item.barColor || "";
                            chronologyStartDay.value = item.startDay || "";
                            chronologyStartMonth.value = item.startMonth || "";
                            chronologyStartYear.value = item.startYear || "";
                            chronologyStartReference.value = item.startReference || "";
                            chronologyEndDay.value = item.endDay || "";
                            chronologyEndMonth.value = item.endMonth || "";
                            chronologyEndYear.value = item.endYear || "";
                            chronologyEndReference.value = item.endReference || "";

                            if (item.dateFormat) {
                                const dateFormatRadio = document.querySelector(`input[name="chronologyDateFormat"][value="${item.dateFormat}"]`);
                                if (dateFormatRadio) {
                                    dateFormatRadio.checked = true;
                                }
                            }

                            if (typeof CheckRegisterType === "function") {
                                CheckRegisterType();
                            }
                            if (typeof DataFormat === "function") {
                                DataFormat();
                            }

                            if (window.jQuery) {
                                window.jQuery("#ChronologyModal").modal("show");
                            }
                        }

                        function getSelectedChronologyDateFormat() {
                            const selected = document.querySelector('input[name="chronologyDateFormat"]:checked');
                            return selected ? selected.value : "Data completa";
                        }

                        function formatChronologyDate(day, month, year, reference, dateFormat) {
                            if (dateFormat === "Somente Ano") {
                                return [year, reference].filter(Boolean).join(" ");
                            }
                            if (dateFormat === "Somente Mês e Ano") {
                                return [month, year, reference].filter(Boolean).join(" ");
                            }
                            return [day, month, year, reference].filter(Boolean).join(" ");
                        }

                        function updateChronologyItemsInput() {
                            chronologyItemsJsonInput.value = JSON.stringify(chronologyItems);
                        }

                        function renderChronologyItems() {
                            chronologyTableBody.innerHTML = "";

                            chronologyItems.forEach((item, index) => {
                                const tr = document.createElement("tr");

                                const tdCode = document.createElement("td");
                                tdCode.textContent = String(index + 1).padStart(3, "0");
                                tr.appendChild(tdCode);

                                const tdTimeline = document.createElement("td");
                                tdTimeline.textContent = item.timelineName;
                                tr.appendChild(tdTimeline);

                                const tdRegisterType = document.createElement("td");
                                tdRegisterType.textContent = item.registerType;
                                tr.appendChild(tdRegisterType);

                                const tdBarColor = document.createElement("td");
                                tdBarColor.textContent = item.barColor || "";
                                tr.appendChild(tdBarColor);

                                const tdStart = document.createElement("td");
                                tdStart.textContent = item.startLabel;
                                tr.appendChild(tdStart);

                                const tdEnd = document.createElement("td");
                                tdEnd.textContent = item.endLabel || "-";
                                tr.appendChild(tdEnd);

                                const tdOptions = document.createElement("td");
                                tdOptions.className = "item-option";

                                const editIcon = document.createElement("i");
                                editIcon.className = "fas fa-pen";
                                editIcon.style.cursor = "pointer";
                                editIcon.style.marginRight = "10px";
                                editIcon.addEventListener("click", function () {
                                    openChronologyModalForEdit(index);
                                });

                                const removeIcon = document.createElement("i");
                                removeIcon.className = "fas fa-trash-alt";
                                removeIcon.style.cursor = "pointer";
                                removeIcon.addEventListener("click", function () {
                                    chronologyItems.splice(index, 1);
                                    updateChronologyItemsInput();
                                    renderChronologyItems();
                                });
                                tdOptions.appendChild(editIcon);
                                tdOptions.appendChild(removeIcon);
                                tr.appendChild(tdOptions);

                                chronologyTableBody.appendChild(tr);
                            });
                        }

                        btnInsertChronology.addEventListener("click", function () {
                            if (!chronologyTimeline.value || !chronologyRegisterType.value) {
                                return;
                            }

                            const dateFormat = getSelectedChronologyDateFormat();
                            const selectedTimelineOption = chronologyTimeline.options[chronologyTimeline.selectedIndex];
                            const startLabel = formatChronologyDate(
                                chronologyStartDay.value,
                                chronologyStartMonth.value,
                                chronologyStartYear.value,
                                chronologyStartReference.value,
                                dateFormat
                            );
                            const endLabel = chronologyRegisterType.value === "Período"
                                ? formatChronologyDate(
                                    chronologyEndDay.value,
                                    chronologyEndMonth.value,
                                    chronologyEndYear.value,
                                    chronologyEndReference.value,
                                    dateFormat
                                )
                                : null;

                            const upsertItem = {
                                idTimeline: chronologyTimeline.value,
                                timelineName: selectedTimelineOption ? selectedTimelineOption.textContent : "",
                                registerType: chronologyRegisterType.value,
                                barColor: chronologyBarColor.value || null,
                                dateFormat,
                                startDay: chronologyStartDay.value || null,
                                startMonth: chronologyStartMonth.value || null,
                                startYear: chronologyStartYear.value || null,
                                startReference: chronologyStartReference.value || null,
                                endDay: chronologyRegisterType.value === "Período" ? (chronologyEndDay.value || null) : null,
                                endMonth: chronologyRegisterType.value === "Período" ? (chronologyEndMonth.value || null) : null,
                                endYear: chronologyRegisterType.value === "Período" ? (chronologyEndYear.value || null) : null,
                                endReference: chronologyRegisterType.value === "Período" ? (chronologyEndReference.value || null) : null,
                                startLabel,
                                endLabel,
                            };

                            if (editingChronologyIndex !== null) {
                                chronologyItems[editingChronologyIndex] = upsertItem;
                            } else {
                                chronologyItems.push(upsertItem);
                            }

                            updateChronologyItemsInput();
                            renderChronologyItems();

                            chronologyTimeline.value = "";
                            chronologyRegisterType.value = "";
                            chronologyBarColor.value = "";
                            chronologyStartDay.value = "";
                            chronologyStartMonth.value = "";
                            chronologyStartYear.value = "";
                            chronologyStartReference.value = "";
                            chronologyEndDay.value = "";
                            chronologyEndMonth.value = "";
                            chronologyEndYear.value = "";
                            chronologyEndReference.value = "";
                            const defaultDateFormat = document.getElementById("option1");
                            if (defaultDateFormat) {
                                defaultDateFormat.checked = true;
                            }
                            if (typeof CheckRegisterType === "function") {
                                CheckRegisterType();
                            }
                            if (typeof DataFormat === "function") {
                                DataFormat();
                            }
                            editingChronologyIndex = null;

                            if (window.jQuery) {
                                window.jQuery("#ChronologyModal").modal("hide");
                            }
                        });

                        updateChronologyItemsInput();
                        renderChronologyItems();
                    });
                </script>

