<!DOCTYPE html>
<html lang="pt-br">
<head>

  <title>TheoMe</title>
  <link rel="icon" type="image/png" href="/images/logo_aba.png"/>

   <!-- Required meta tags -->
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

   <!-- Bootstrap CSS -->
   <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

   <!-- font -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"/>
   <!-- icons -->
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css">
    
    <!-- bootstrap customization -->
      <link rel="stylesheet" href="/styles/parts/main.css" />
      <link rel="stylesheet" href="/styles/parts/header.css" />
      <link rel="stylesheet" href="/styles/parts/footer.css" />
      <link rel="stylesheet" href="/styles/parts/button.css" />
      <link rel="stylesheet" href="/styles/parts/form.css" />
      <link rel="stylesheet" href="/styles/parts/grid.css" />
</head>

<body>
    
 <!-- jQuery first, then Popper.js, then Bootstrap JS -->
 <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
 <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
 <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>

    <%- include('../parts/header')  %>

    <%- include('../parts/navbar')  %>

    <main>
        <h1>Editar - Usuário</h1>

        <div class="alert <%= messages.alertType %> <%= messages.display %> alertPosition" role="alert">
            <input class="inputAlertMessage" value="<%= messages.textMessage %>" disabled>
            <a href="#" data-dismiss="alert"><i class="fas fa-times closeAlertMessage"></i></a>
        </div>

        <form id="form-user" method="post" action="/cms-User-U/<%= userId %>" enctype="multipart/form-data" autocomplete="off">
            <fieldset class="flex">
                <div class="row">
                    <div class="col-md-4">
                        <label form-label>Código</label>
                        <input type="text" class="form-control" disabled value="<%= userId %>">
                    </div>
                    <div class="col-md-4">
                        <label for="userStatus" form-label>Status</label>
                        <select id="userStatus" name="userStatus" class="form-control">
                            <option value="1" <%= user.userStatus === 1 ? "selected" : "" %>>Ativo</option>
                            <option value="0" <%= user.userStatus === 0 ? "selected" : "" %>>Inativo</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label for="userName" form-label>Nome completo</label>
                        <input class="form-control" type="text" id="userName" name="userName" maxlength="150" value="<%= user.userName %>" required>
                    </div>
                    <div class="col-md-6">
                        <label for="userEmail" form-label>E-mail (usado no login)</label>
                        <input class="form-control" type="email" id="userEmail" name="userEmail" maxlength="254" value="<%= user.userEmail %>" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label for="userPassword" form-label>Nova senha (deixe em branco para manter a atual)</label>
                        <input class="form-control" type="password" id="userPassword" name="userPassword" minlength="8" maxlength="72" autocomplete="new-password">
                    </div>
                    <div class="col-md-6">
                        <label for="userPasswordConfirm" form-label>Confirmar nova senha</label>
                        <input class="form-control" type="password" id="userPasswordConfirm" name="userPasswordConfirm" minlength="8" maxlength="72" autocomplete="new-password">
                    </div>
                </div>
            </fieldset>

            <%- include('cms-User-ProfileFields', { avatarUserId: userId }) %>

            <fieldset class="flex">
                <legend>Permissões de acesso (área logada)</legend>
                <% if (permissionOptions.length === 0) { %>
                    <p>Nenhuma permissão cadastrada. <a href="/cms-Permission-C">Cadastrar permissão</a></p>
                <% } %>
                <div class="row">
                    <% permissionOptions.forEach((permission) => { %>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="permissionIds" id="permission-<%= permission.id %>" value="<%= permission.id %>" <%= user.permissionIds.includes(permission.id) ? "checked" : "" %>>
                                <label class="form-check-label" for="permission-<%= permission.id %>">
                                    <%= permission.name %><% if (permission.status !== 1) { %> (inativa)<% } %>
                                    <br><small class="text-muted"><%= permission.code %></small>
                                </label>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </fieldset>
        </form>

                        <!-- BUTTON AREA -->
                        <div class="button-area">
                            <a href="#">
                                <div class="button-frame">
                                    <button class="btn btn-success" form="form-user" type="submit">Salvar</button>
                                </div>
                            </a>
                            <a href="/cms-User-Q">
                                <div class="button-frame">
                                    <button class="btn btn-secondary">Cancelar</button>
                                </div>
                            </a>
                            <a href="#">
                                <div class="button-frame">
                                    <button class="btn btn-danger" data-toggle="modal" data-target="#DeleteModal">Excluir</button>
                                </div>
                            </a>
                        </div>

    </main>

    <div class="modal fade" id="DeleteModal" aria-hidden="true">
        <div class="modal-dialog modal-md">
            <%- include('../cms/cms-User-D') %>
        </div>
    </div>

    <%- include('../parts/footer')  %>

</body>
