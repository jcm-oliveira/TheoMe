<!DOCTYPE html>
<html lang="pt-br">
<head>

  <title>TheoMe</title>
  <link rel="icon" type="image/png" href="/images/logo_aba.png"/>

   <!-- Required meta tags -->
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

   <!-- Bootstrap CSS -->
   <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

   <!-- font -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"/>
   <!-- icons -->
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css">
    
    <!-- bootstrap customization -->
      <link rel="stylesheet" href="/styles/parts/main.css" />
      <link rel="stylesheet" href="/styles/parts/header.css" />
      <link rel="stylesheet" href="/styles/parts/footer.css" />
      <link rel="stylesheet" href="/styles/parts/button.css" />
      <link rel="stylesheet" href="/styles/parts/form.css" />
      <link rel="stylesheet" href="/styles/parts/modal.css" />
</head>

<body>
  
 <!-- Modal content -->
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="BibliographicReferenceModal">Inserir - Item associado</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form>
        
           <div class="col-md-12">
              <label for="" class="form-label">Perspectiva Histórica</label>
              <select id="associationHistoricalPerspective" class="form-control">
                <option value="" data-default disabled selected></option>
                <% historicalPerspectives.forEach((item)=> { %>
                  <option value="<%-item.id%>"><%-item.name%></option>
                <% }) %>
              </select>
            </div>
             <div class="col-md-12">
              <label for="" class="form-label">Categoria Nível 1</label>
              <select id="associationCategoryLevel1" class="form-control">
                <option value="" data-default disabled selected></option>
                <% categoryLevel1List.forEach((item)=> { %>
                  <option value="<%-item.id%>"><%-item.name%></option>
                <% }) %>
              </select>
            </div>
             <div class="col-md-12">
              <label for="" class="form-label">Categoria Nível 2</label>
              <select id="associationCategoryLevel2" class="form-control">
                <option value="" data-default disabled selected></option>
                <% categoryLevel2List.forEach((item)=> { %>
                  <option value="<%-item.id%>"><%-item.name%></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-12">
              <label for="" class="form-label">Categoria Nível 3</label>
              <select id="associationCategoryLevel3" class="form-control">
                <option value="" data-default disabled selected></option>
                <% categoryLevel3List.forEach((item)=> { %>
                  <option value="<%-item.id%>"><%-item.name%></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-12">
              <label for="" class="form-label">Seção</label>
              <select id="associationSection" class="form-control">
                <option value="" data-default disabled selected></option>
                <% sectionList.forEach((item)=> { %>
                  <option value="<%-item.id%>"><%-item.name%></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-12">
              <label for="" class="form-label">Tipo de Associação</label>
              <input type="text" id="associationType" class="form-control" maxlength="100">
            </div>
        
            <div class="col-md-12">
              <label for="" class="form-label">Item de Estudo Associado</label>
              <select id="associationStudyItem" class="form-control">
                <option value="" data-default disabled selected></option>
                <% studyItems.forEach((item)=> { %>
                  <option value="<%-item.id%>"><%-item.name%></option>
                <% }) %>
              </select>
            </div>      
        
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="btnInsertAssociation">Inserir</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
        
      </div>
    </div>
    
</body>