<!DOCTYPE html>
<html lang="pt-br">
<head>
  <title>TheoMe</title>
  <link rel="icon" type="image/png" href="/images/logo_aba.png"/>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles/parts/main.css" />
  <link rel="stylesheet" href="/styles/parts/header.css" />
  <link rel="stylesheet" href="/styles/parts/footer.css" />
  <link rel="stylesheet" href="/styles/parts/button.css" />
  <link rel="stylesheet" href="/styles/parts/form.css" />
  <link rel="stylesheet" href="/styles/parts/modal.css" />
</head>
<body>
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="DeleteModal">Excluir</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
            <p>Tem certeza que deseja excluir o registro n° <b><%= section.id %></b> ?</p>
        </div>
        <div class="modal-footer">
            <a href="#"><div class="button-frame"><button class="btn btn-danger" type="submit" form="form-delete">Sim</button></div></a>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Não</button>
        </div>
        <form id="form-delete" method="post" action="/cms-Section-D/<%= section.id %>"></form>
    </div>
</body>
