<!DOCTYPE html>
<html lang="pt-br">
<head>

  <title>TheoMe</title>

   <!-- Required meta tags -->
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

   <!-- Bootstrap CSS -->
   <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

   <!-- font -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"/>
   <!-- icons -->
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css">
    
    <!-- bootstrap customization -->
      <link rel="stylesheet" href="/styles/parts/main.css" />
      <link rel="stylesheet" href="/styles/parts/header.css" />
      <link rel="stylesheet" href="/styles/parts/footer.css" />
      <link rel="stylesheet" href="/styles/parts/button.css" />
      <link rel="stylesheet" href="/styles/parts/form.css" />
      <link rel="stylesheet" href="/styles/parts/modal.css" />
</head>

<body>
  
 <!-- Modal content -->
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="ChronologyModal">Inserir - Registro na linha do tempo</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form>
            
                  <div class="row">
                    <div class="col-md-9">
                        <label for="" class="form-label">Linha temporal</label>
                        <select name="temporalyPerspective" class="form-control">
                            <option value=""data-default disabled selected></option>
                            <option value="">Cronologia Bíblica</option>                
                            <option value="">Governantes</option>
                            <option value="">Guerras</option>
                            <option value="">Impérios/Potências</option> 
                            <option value="">Livros da Bíblia</option> 
                            <option value="">Personagens Bíblicos</option> 
                            <option value="">Personagens Políticos</option>                               
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="" class="form-label">Tipo de registro</label>
                        <select name="registerType" class="form-control" id="RegisterType">
                            <option value=""data-default disabled selected></option>               
                            <option value="Marco">Marco</option>
                            <option value="Período">Período</option>
                        </select>
                    </div>
                </div>

                    <div class="row">

                        <div class="col-md-6">
                            <label for="" class="form-label">Período histórico</label>
                            <select name="dataFormat" class="form-control">
                                <option value=""data-default disabled selected></option>
                                <option value="">Pré-histórica</option>                
                                <option value="">Idade Antiga</option>
                                <option value="">Idade Contemporânea</option>
                                <option value="">Idade Média</option>
                                <option value="">Idade Moderna</option>                            
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="" class="form-label">Século</label>
                            <select name="dataFormat" class="form-control">
                                <option value=""data-default disabled selected></option>    
                                <option value="">I</option>
                                <option value="">II</option>
                                <option value="">III</option>  
                                <option value="">IV</option>  
                                <option value="">V</option>  
                                <option value="">VI</option>  
                                <option value="">VII</option>                    
                            </select>
                        </div>                    
                        <div class="col-md-4">
                            <label for="" class="form-label">Formato data</label>
                            <select name="dataFormat" class="form-control">
                                <option value=""data-default disabled selected></option>                
                                <option value="">Data completa</option>
                                <option value="">Somente Mês e Ano</option>
                                <option value="">Somente Ano</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">    
                        <div class="col-md-4">
                            <label for="" class="form-label">Data início</label>
                            <input type="text" class="form-control">
                        </div>
                        <div class="col-md-2">
                            <label for="" class="form-label">Ref.</label>
                            <select name="christReference" class="form-control">
                                <option value=""data-default disabled selected></option>                
                                <option value="">a.C</option>
                                <option value="">d.C</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="" class="form-label">Data término</label>
                            <input type="text" class="form-control" id="EndDate">
                        </div>
                        <div class="col-md-2">
                            <label for="">Ref.</label>
                            <select name="christReference" class="form-control">
                                <option value=""data-default disabled selected></option>                
                                <option value="">a.C</option>
                                <option value="">d.C</option>
                            </select>
                        </div>
                    </div>  

        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-success">Inserir</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
        
      </div>
    </div>
    
</body>