# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# O arquivo .env NÃO deve ser versionado.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=theome

# Segredo que assina o cookie de sessão (mínimo 32 caracteres, aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Em produção: NODE_ENV=production faz o cookie de sessão trafegar só por HTTPS.
# NODE_ENV=production
# Endereço público do site, se for diferente do Host recebido (ex.: https://theome.org).
# APP_ORIGIN=
